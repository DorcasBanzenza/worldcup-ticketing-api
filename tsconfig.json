{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@mock/*": ["./src/mock/*"]
    }
  }
}